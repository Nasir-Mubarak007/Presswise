# Copy to .env.local and fill in when a feature needs it.
# Demo mode runs without any of these: PRESSWISE_DEMO=1 seeds data in memory.

# Neon: the pooled string for the app, the unpooled one for migrations.
# Include sslmode=verify-full in DATABASE_URL to avoid relying on legacy aliases.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# A throw away Neon branch for the data contract suite
TEST_DATABASE_URL=

BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google sign in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

PAYSTACK_SECRET_KEY=
PLATFORM_FEE_PERCENT=
PAYSTACK_FEE_BEARER=
ORDER_ACCESS_SECRET=

# Local only. Both flags are ignored in production.
PRESSWISE_DEMO=1
PRESSWISE_MEMORY_AUTH=
