# Copy to .env.local and fill in when a feature needs it.
# Demo mode runs without any of these: PRESSWISE_DEMO=1 seeds data in memory.

# Neon: the pooled string for the app, the unpooled one for migrations.
# Include sslmode=verify-full in DATABASE_URL to avoid relying on legacy aliases.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# A throw away Neon branch for the data contract suite
TEST_DATABASE_URL=

BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google sign in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# Backblaze B2 template only. Not active until B2 support is implemented.
# Copy these names to .env.local, then replace the example values with your B2 details.
# Use the S3 endpoint and region shown for your bucket in Backblaze.
BACKBLAZE_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
BACKBLAZE_B2_REGION=<region>
BACKBLAZE_B2_BUCKET=<private-bucket-name>
BACKBLAZE_B2_KEY_ID=<application-key-id>
BACKBLAZE_B2_APPLICATION_KEY=<application-key-secret>

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BULLMQ_REDIS_URL=
STOREFRONT_BASE_DOMAIN=
PRINTER_EXPERIENCE_ENABLED=0

PAYSTACK_SECRET_KEY=
PLATFORM_FEE_PERCENT=
PAYSTACK_FEE_BEARER=
ORDER_ACCESS_SECRET=

# Local only. Both flags are ignored in production.
PRESSWISE_DEMO=1
PRESSWISE_MEMORY_AUTH=
